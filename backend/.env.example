NODE_ENV=development
PORT=5000

# Database (SQLite - archivo local)
DB_FILE=facturacion.db

# CORS
CORS_ORIGIN=*

# Asana (botones "Generar tarea en Asana" / "Asignar responsables" en
# Órdenes) — Personal Access Token de tu cuenta de Asana: ícono de perfil →
# Configuración de la cuenta → Apps → Administrar apps de desarrollador →
# Crear nuevo token. El proyecto y las secciones por mes se configuran desde
# la solapa "Asana" de la app, no acá.
ASANA_ACCESS_TOKEN=

# Telegram (avisos automáticos: orden nueva cargada / campañas que arrancan
# hoy, al grupo "Operaciones") — hablále a @BotFather en Telegram, /newbot,
# y pegá acá el token que te da. El chat_id de cada grupo se carga después
# desde la app, no acá.
TELEGRAM_BOT_TOKEN=
